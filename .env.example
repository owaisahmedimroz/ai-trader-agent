# Is file ko copy karke ".env" naam se save karein aur values bharein.
# ".env" GitHub par kabhi upload nahi hoti (.gitignore mein hai).
# Yeh values kabhi chat ya screenshot mein share na karein.

# Claude API (agent ka "dimaagh" — Phase 3)
ANTHROPIC_API_KEY=

# Telegram bot (@BotFather se token). Chat ID na pata ho to khali chhor dein:
# bot ko /start bhejein, woh aapki chat ID bata dega.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MT5 demo account (sirf price data ke liye — is par trade nahi hoti)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
